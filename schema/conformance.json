{
  "about": "Machine-readable form of docs/ontology.md, taxonomy.md, coding-systems.md and standards.md. Checked by `python -m etl.conformance`.",
  "vocabularies": {
    "kg": {"name": "Project ontology", "iri": "https://samyama.ai/kg/maths-research#"},
    "prov": {"name": "PROV-O", "iri": "http://www.w3.org/ns/prov#"},
    "skos": {"name": "SKOS", "iri": "http://www.w3.org/2004/02/skos/core#"},
    "dcterms": {"name": "Dublin Core terms", "iri": "http://purl.org/dc/terms/"},
    "foaf": {"name": "FOAF", "iri": "http://xmlns.com/foaf/0.1/"},
    "schema": {"name": "Schema.org", "iri": "https://schema.org/"},
    "cito": {"name": "CiTO", "iri": "http://purl.org/spar/cito/"},
    "ontomath": {"name": "OntoMathPRO", "iri": "http://ontomathpro.org/ontology/"},
    "omdoc": {"name": "OMDoc", "iri": "http://omdoc.org/ontology#"}
  },
  "mapping_predicates": ["rdfs:subClassOf", "rdfs:subPropertyOf", "rdfs:seeAlso", "kg:mapsTo"],
  "codes": {
    "provenance": ["catalog-synthesized", "schema-vocabulary"],
    "source": ["maths_research", "project_schema"],
    "method": ["parsed", "title-matched", "keyword-classified", "list-matched", "mapped", "catalog"],
    "status": ["open", "partially-solved", "solved-recently", "empirically-supported"],
    "catalog_provenance": ["synthesized", "verified"],
    "problem_kind": ["conjecture", "hypothesis", "problem", "programme", "theorem", "question"],
    "result_type": ["bound", "computational", "special_case", "conditional", "counterexample", "other", "summary"],
    "role": ["foundational", "sota", "survey", "book", "technique", "partial", "computational", "related", "other", "untagged"],
    "relation_kind": ["implies", "implied_by", "equivalent", "generalizes", "special_case", "related"],
    "confidence": ["frontier-verify", "stated"],
    "formalization": ["mentioned", "none-mentioned"],
    "parse_status": ["parsed", "partial", "raw"],
    "value_method": ["title-keyword", "tag-keyword", "bullet-keyword", "bullet-lead-in", "no-bullets"],
    "scheme": ["subtopic", "msc2020", "arxiv", "acm-ccs", "famous-list"],
    "famous_list": ["millennium", "hilbert", "smale", "erdos"]
  },
  "labels": {
    "DataSource": {"id": "^datasource:maths_research$", "required": ["name", "version", "licence"]},
    "Topic": {"id": "^topic:\\d\\d-[a-z-]+$", "required": ["slug", "number", "name", "scope"]},
    "TaxonomyTerm": {"id": "^(subtopic|msc2020|arxiv|acm-ccs|list):\\S+$", "required": ["scheme", "notation", "label"],
                     "codes": {"scheme": "scheme"}},
    "Problem": {"id": "^\\d\\d-[a-z-]+/[a-z0-9-]+$",
                "required": ["slug", "title", "status", "kind", "kind_method", "catalog_provenance", "statement",
                             "formalization", "frontier_flags", "first_added", "last_reviewed"],
                "codes": {"status": "status", "kind": "problem_kind", "kind_method": "value_method",
                          "catalog_provenance": "catalog_provenance", "formalization": "formalization"},
                "year_month": ["first_added", "last_reviewed", "last_substantive_update", "stale_since"]},
    "Result": {"id": "#s4(-\\d+)?$", "required": ["section", "ordinal", "text", "result_type", "result_type_method", "confidence"],
               "codes": {"result_type": "result_type", "result_type_method": "value_method", "confidence": "confidence"},
               "section": 4},
    "Obstacle": {"id": "#s5-\\d+$", "required": ["section", "ordinal", "text"], "section": 5},
    "Gap": {"id": "#s6$", "required": ["section", "ordinal", "text"], "section": 6},
    "ResearchDirection": {"id": "#s7-\\d+$", "required": ["section", "ordinal", "text", "confidence"],
                          "codes": {"confidence": "confidence"}, "section": 7},
    "FutureDirection": {"id": "#s8-\\d+$", "required": ["section", "ordinal", "text"], "section": 8},
    "WorkedExample": {"id": "#s10$", "required": ["section", "ordinal", "text"], "section": 10},
    "Paper": {"id": "^(doi:10\\.\\d{4,9}/\\S+|paper:[0-9a-f]{16})$", "required": ["raw_citation", "parse_status"],
              "codes": {"parse_status": "parse_status"}},
    "Concept": {"id": "^concept:[a-z0-9-]+$", "required": ["name", "problem_count", "topic_count"]}
  },
  "page_derived": ["Topic", "Problem", "Result", "Obstacle", "Gap", "ResearchDirection", "FutureDirection",
                   "WorkedExample", "Paper"],
  "relations": {
    "IN_TOPIC": {"domain": ["Problem"], "range": ["Topic"]},
    "HAS_RESULT": {"domain": ["Problem"], "range": ["Result"]},
    "HAS_OBSTACLE": {"domain": ["Problem"], "range": ["Obstacle"]},
    "HAS_GAP": {"domain": ["Problem"], "range": ["Gap"]},
    "HAS_RESEARCH": {"domain": ["Problem"], "range": ["ResearchDirection"]},
    "HAS_FUTURE": {"domain": ["Problem"], "range": ["FutureDirection"]},
    "HAS_EXAMPLE": {"domain": ["Problem"], "range": ["WorkedExample"]},
    "CITES": {"domain": ["Problem"], "range": ["Paper"], "codes": {"role": "role", "role_method": "value_method"}},
    "INVOLVES": {"domain": ["Problem"], "range": ["Concept"], "codes": {"method": "method"}},
    "RELATED_TO": {"domain": ["Problem"], "range": ["Problem"], "required": ["evidence"],
                   "codes": {"kind": "relation_kind", "method": "method"}},
    "CLASSIFIED_AS": {"domain": ["Topic", "Problem"], "range": ["TaxonomyTerm"], "codes": {"method": "method"}},
    "PART_OF_LIST": {"domain": ["Problem"], "range": ["TaxonomyTerm"], "required": ["evidence"],
                     "codes": {"method": "method"}},
    "BROADER": {"domain": ["TaxonomyTerm"], "range": ["TaxonomyTerm", "Topic"]},
    "FROM_SOURCE": {"domain": ["Topic", "TaxonomyTerm", "Problem", "Result", "Obstacle", "Gap", "ResearchDirection",
                               "FutureDirection", "WorkedExample", "Paper", "Concept"], "range": ["DataSource"]}
  },
  "mappings": [
    ["kg:DataSource", "rdfs:subClassOf", "prov:Entity"],
    ["kg:FROM_SOURCE", "rdfs:subPropertyOf", "prov:wasDerivedFrom"],
    ["kg:source_url", "kg:mapsTo", "prov:wasDerivedFrom"],
    ["kg:retrieved_at", "kg:mapsTo", "prov:generatedAtTime"],
    ["kg:method", "kg:mapsTo", "prov:wasGeneratedBy"],
    ["kg:TaxonomyTerm", "rdfs:subClassOf", "skos:Concept"],
    ["kg:Topic", "rdfs:subClassOf", "skos:Concept"],
    ["kg:BROADER", "rdfs:subPropertyOf", "skos:broader"],
    ["kg:notation", "kg:mapsTo", "skos:notation"],
    ["kg:label", "kg:mapsTo", "skos:prefLabel"],
    ["kg:terms", "kg:mapsTo", "skos:altLabel"],
    ["kg:scheme", "kg:mapsTo", "skos:inScheme"],
    ["kg:title", "kg:mapsTo", "dcterms:title"],
    ["kg:source_date", "kg:mapsTo", "dcterms:date"],
    ["kg:CLASSIFIED_AS", "rdfs:subPropertyOf", "dcterms:subject"],
    ["kg:licence", "kg:mapsTo", "dcterms:license"],
    ["kg:authors", "kg:mapsTo", "foaf:name"],
    ["kg:Paper", "rdfs:subClassOf", "schema:ScholarlyArticle"],
    ["kg:doi", "kg:mapsTo", "schema:identifier"],
    ["kg:venue", "kg:mapsTo", "schema:isPartOf"],
    ["kg:CITES", "rdfs:subPropertyOf", "cito:cites"],
    ["kg:role=foundational", "kg:mapsTo", "cito:citesAsAuthority"],
    ["kg:role=survey", "kg:mapsTo", "cito:citesAsRecommendedReading"],
    ["kg:role=book", "kg:mapsTo", "cito:citesAsRecommendedReading"],
    ["kg:role=sota", "kg:mapsTo", "cito:citesForInformation"],
    ["kg:role=related", "kg:mapsTo", "cito:citesForInformation"],
    ["kg:role=technique", "kg:mapsTo", "cito:usesMethodIn"],
    ["kg:role=partial", "kg:mapsTo", "cito:citesAsEvidence"],
    ["kg:role=computational", "kg:mapsTo", "cito:citesAsDataSource"],
    ["kg:role=other", "kg:mapsTo", "cito:cites"],
    ["kg:role=untagged", "kg:mapsTo", "cito:cites"],
    ["kg:Problem", "kg:mapsTo", "ontomath:Problem"],
    ["kg:Concept", "kg:mapsTo", "ontomath:MathematicalObject"],
    ["kg:Result", "kg:mapsTo", "ontomath:Statement"],
    ["kg:kind=conjecture", "kg:mapsTo", "omdoc:conjecture"],
    ["kg:kind=hypothesis", "kg:mapsTo", "omdoc:conjecture"],
    ["kg:kind=theorem", "kg:mapsTo", "omdoc:theorem"],
    ["kg:WorkedExample", "kg:mapsTo", "omdoc:example"]
  ]
}
